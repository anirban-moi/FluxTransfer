###############################################################################
# FluxTransfer
# Global Git Attributes
###############################################################################

# Auto detect text files and normalize line endings
* text=auto

###############################################################################
# Source Code
###############################################################################

*.c           text
*.cpp         text
*.cc          text
*.cxx         text
*.h           text
*.hpp         text
*.hh          text
*.hxx         text

*.go          text
*.js          text
*.ts          text
*.tsx         text
*.jsx         text

*.json        text
*.yml         text
*.yaml        text
*.xml         text
*.toml        text
*.ini         text

*.md          text
*.txt         text

*.cmake       text
CMakeLists.txt text

###############################################################################
# Shell Scripts
###############################################################################

*.sh          text eol=lf
*.ps1         text eol=crlf
*.bat         text eol=crlf

###############################################################################
# Binary Files
###############################################################################

*.png         binary
*.jpg         binary
*.jpeg        binary
*.gif         binary
*.ico         binary
*.bmp         binary
*.pdf         binary
*.zip         binary
*.7z          binary
*.tar         binary
*.gz          binary

###############################################################################
# Executables
###############################################################################

*.exe         binary
*.dll         binary
*.so          binary
*.dylib       binary
*.lib         binary
*.a           binary

###############################################################################
# Documentation
###############################################################################

LICENSE       text
README.md     text